<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target gives us WinRT's InkAnalyzer for ink-to-shape. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>InkOverlay</AssemblyName>
    <!-- The release's version; the installer and the plugin's manifest carry the same one. -->
    <Version>0.0.1</Version>
    <RootNamespace>InkOverlay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <!-- Older SDKs pick a Windows projection with WinRT.Runtime 2.0, which Vortice can't load (pencil ink crashed). -->
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <!-- Carries its own .NET: nobody has a separate runtime to install, or an admin prompt to answer. -->
    <SelfContained>true</SelfContained>
    <!-- .NET and WPF carry translated error messages in a dozen languages; nobody reads this helper's. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Precompiled, so it starts fast: the helper is relaunched on wake and after a lost pen. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- Direct2D, for Windows' own ink renderer (the real pencil texture; see WindowsInk.cs). -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

</Project>
